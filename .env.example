# Real values go in .env.local and in Vercel env. Never prefix with NEXT_PUBLIC_.
# Firebase web config (public identifiers): Project settings -> Your apps.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# SECRET. The whole service account key file (Project settings -> Service accounts), one line.
FIREBASE_SERVICE_ACCOUNT=
# Long random string; GET /api/export needs "Authorization: Bearer <this>".
EXPORT_TOKEN=
# Invite links are /study?code=<this>. Required in production builds; optional in `next dev`.
STUDY_CODE=
# test (default), pilot or confirmatory. Pilot: two uniform-random rounds after the static one.
# Confirmatory: one round in arm A/B/C; needs data/policy.frozen.json.
STUDY_PHASE=
