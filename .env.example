# Server only. Put real values in .env.local and in Vercel env. Never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Long random string; GET /api/export needs "Authorization: Bearer <this>".
EXPORT_TOKEN=
# Invite links are /study?code=<this>. Required in production builds; optional in `next dev`.
STUDY_CODE=
# test (default) or pilot. Pilot: two uniform-random rounds after the static one.
STUDY_PHASE=
