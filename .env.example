# Server only. Put real values in .env.local and in Vercel env. Never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Long random string; GET /api/export needs "Authorization: Bearer <this>".
EXPORT_TOKEN=
# Invite links are /study?code=<this>. Required in production builds; optional in `next dev`.
STUDY_CODE=
# test (default), pilot or confirmatory. Pilot: two uniform-random rounds after the static one.
# Confirmatory: one round in arm A/B/C; needs data/policy.frozen.json.
STUDY_PHASE=
# One admin account for /admin (live demo X-Ray). Use a long password.
# Setting it also turns on sign-in for /demo (or set SESSION_SECRET to sign store cookies).
ADMIN_USER=
ADMIN_PASSWORD=
